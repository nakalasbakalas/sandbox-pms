generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id              String     @id @default(cuid())
  code            String     @unique
  name            String
  address         String?
  phone           String?
  email           String?
  publicWebsite   String?
  lineId          String?
  lineUrl         String?
  supportHours    String?
  reservationAlertEmail String?
  timezone        String     @default("Asia/Bangkok")
  defaultCheckIn  String     @default("14:00")
  defaultCheckOut String     @default("12:00")
  currency        String     @default("THB")
  taxRate         Float      @default(0)
  taxRateBasisPoints Int?
  extraGuestFee   Float      @default(200)
  extraGuestFeeSatang BigInt?
  childFee        Float      @default(100)
  childFeeSatang  BigInt?
  inventoryMinimumRate Float?
  inventoryMinimumRateSatang BigInt?
  taxConfiguration Json?
  policies        Json?
  operationalSettings Json?
  sourceNotes     Json?
  rooms           Room[]
  roomTypes       RoomType[]
  bookingEmailSources BookingEmailSource[]
  bookingEmailEvents  BookingEmailEvent[]
  hotelOpsTasks        HotelOpsTask[]
  hotelOpsTrendAlerts  HotelOpsTrendAlert[]
  hotelOpsEmergencyStop HotelOpsEmergencyStop?
  hotelOpsNotifications HotelOpsNotification[]
  hotelOpsScanSnapshots HotelOpsScanSnapshot[]
  userMemberships UserPropertyMembership[]
  guests          Guest[]
  charges         Charge[]
  payments        Payment[]
  auditLogs       AuditLog[]
  domainEvents    DomainEvent[]
  housekeepingTasks HousekeepingTask[]
  housekeepingIssues HousekeepingIssue[]
  nightAuditRuns  NightAuditRun[]
  nightAuditAttempts NightAuditAttempt[]
  accountingFolios AccountingFolio[]
  cashShifts CashShift[]
  houseAccounts HouseAccount[]
  journalEntries JournalEntry[]
  publicBookingQuotes PublicBookingQuote[]
  channels Channel[]
  autonomyPolicies AutonomyPolicy[]
  externalProviderEvents ExternalProviderEvent[]
  providerSyncCursors ProviderSyncCursor[]
  providerSnapshots ProviderSnapshot[]
  autonomyRuns AutonomyRun[]
  agentDecisions AgentDecision[]
  actionExecutions ActionExecution[]
  reconciliationIssues ReconciliationIssue[]
  deadLetterEvents DeadLetterEvent[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model RoomType {
  id             String        @id @default(cuid())
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  baseRate       Float
  baseRateSatang BigInt?
  maxOccupancy   Int
  standardOcc    Int
  rooms          Room[]
  reservations   Reservation[]
  holds          InventoryHold[]
  publicBookingQuotes PublicBookingQuote[]
  
  @@unique([propertyId, code])
  @@index([propertyId])
}

model Room {
  id                 String              @id @default(cuid())
  propertyId         String
  property           Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId         String
  roomType           RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  number             String
  floor              Int
  operationalStatus  RoomOpStatus        @default(AVAILABLE)
  currentStatus      RoomStatus          @default(VACANT_CLEAN)
  currentReservation String?             @unique
  blockedUntil       DateTime?
  notes              String?
  inventory          RoomDateInventory[]
  statusHistory      RoomStatusLog[]
  housekeepingTasks  HousekeepingTask[]
  housekeepingIssues HousekeepingIssue[]
  assignedReservations Reservation[]     @relation("AssignedRoom")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  
  @@unique([propertyId, number])
  @@index([propertyId])
  @@index([roomTypeId])
  @@index([operationalStatus, currentStatus])
}

enum RoomOpStatus {
  AVAILABLE
  OUT_OF_SERVICE
  OUT_OF_ORDER
  BLOCKED
}

enum RoomStatus {
  VACANT_CLEAN
  VACANT_DIRTY
  CLEANING
  INSPECTED
  OCCUPIED_CLEAN
  OCCUPIED
  OCCUPIED_DIRTY
}

model Guest {
  id           String        @id @default(cuid())
  propertyId   String
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  firstName    String
  lastName     String
  email        String?
  phone        String?
  nationality  String?
  idType       String?
  idNumber     String?
  dateOfBirth  DateTime?
  vipStatus    Boolean       @default(false)
  blacklisted  Boolean       @default(false)
  preferences  Json?
  notes        String?
  reservations Reservation[]
  documents    GuestDocument[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  @@index([email])
  @@index([propertyId, updatedAt])
  @@index([phone])
  @@index([lastName, firstName])
}

model Reservation {
  id                String              @id @default(cuid())
  confirmationCode  String              @unique @default(cuid())
  propertyId        String
  guestId           String
  guest             Guest               @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomTypeId        String
  roomType          RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  assignedRoomId    String?
  assignedRoom      Room?               @relation("AssignedRoom", fields: [assignedRoomId], references: [id], onDelete: SetNull)
  
  checkIn           DateTime            @db.Date
  checkOut          DateTime            @db.Date
  actualCheckIn     DateTime?
  actualCheckOut    DateTime?
  
  status            ReservationStatus   @default(CONFIRMED)
  
  adults            Int
  children          Int                 @default(0)
  childAges         Int[]
  
  ratePerNight      Float
  ratePerNightSatang BigInt?
  totalAmount       Float
  totalAmountSatang BigInt?
  depositAmount     Float               @default(0)
  depositAmountSatang BigInt?
  depositPaid       Boolean             @default(false)
  
  source            BookingSource       @default(DIRECT)
  channelRef        String?
  sourceEmailEventId String?             @unique
  sourceEmailEvent  BookingEmailEvent?   @relation("ReservationSourceEmail", fields: [sourceEmailEventId], references: [id], onDelete: SetNull)
  
  notes             String?
  specialRequests   String?
  
  inventory         RoomDateInventory[]
  folio             Folio?
  accountingFolios  AccountingFolio[]
  history           ReservationLog[]
  bookingEmailEvents BookingEmailEvent[] @relation("BookingEmailEventReservation")
  documents         GuestDocument[]
  publicHold         InventoryHold?
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  
  @@index([propertyId, checkIn, checkOut])
  @@index([guestId])
  @@index([status, checkIn])
  @@index([assignedRoomId])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  HOLD
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  DIRECT
  WALK_IN
  PHONE
  EMAIL
  WEBSITE
  BOOKING_COM
  AGODA
  EXPEDIA
  AIRBNB
  OTHER
}

model RoomDateInventory {
  id            String          @id @default(cuid())
  propertyId    String
  roomId        String
  room          Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date          DateTime        @db.Date
  
  reservationId String?
  reservation   Reservation?    @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  
  status        InventoryStatus @default(AVAILABLE)
  
  holdId        String?
  hold          InventoryHold?  @relation(fields: [holdId], references: [id], onDelete: SetNull)
  
  rate          Float?
  rateSatang    BigInt?
  notes         String?
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  @@unique([roomId, date])
  @@index([propertyId, date, status])
  @@index([reservationId])
  @@index([date, status])
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  HELD
  BLOCKED
  OUT_OF_SERVICE
}

model InventoryHold {
  id         String              @id @default(cuid())
  propertyId String
  roomTypeId String
  roomType   RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  quoteId    String?
  quote      PublicBookingQuote? @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  reservationId String?          @unique
  reservation Reservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  publicTokenHash String?         @unique
  idempotencyKey String?
  conversionIdempotencyKey String?
  checkIn    DateTime            @db.Date
  checkOut   DateTime            @db.Date
  expiresAt  DateTime
  status     HoldStatus          @default(ACTIVE)
  createdBy  String
  email      String?
  phone      String?
  notes      String?
  inventory  RoomDateInventory[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  
  @@index([expiresAt, status])
  @@index([propertyId, status])
  @@index([quoteId])
  @@unique([propertyId, idempotencyKey])
  @@unique([propertyId, conversionIdempotencyKey])
}

model PublicBookingQuote {
  id                 String          @id @default(cuid())
  propertyId         String
  property           Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  roomTypeId         String
  roomType           RoomType        @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  checkIn            DateTime        @db.Date
  checkOut           DateTime        @db.Date
  adults             Int
  children           Int             @default(0)
  ratePerNightSatang BigInt
  totalSatang        BigInt
  currency           String          @default("THB")
  snapshot           Json
  idempotencyKey     String
  holds              InventoryHold[]
  createdAt          DateTime        @default(now())

  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, roomTypeId, checkIn, checkOut])
  @@index([createdAt])
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

model Folio {
  id            String      @id @default(cuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  
  subtotal      Float       @default(0)
  subtotalSatang BigInt?
  tax           Float       @default(0)
  taxSatang     BigInt?
  total         Float       @default(0)
  totalSatang   BigInt?
  paid          Float       @default(0)
  paidSatang    BigInt?
  balance       Float       @default(0)
  balanceSatang BigInt?
  
  status        FolioStatus @default(OPEN)
  
  charges       Charge[]
  payments      Payment[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  @@index([status])
}

enum FolioStatus {
  OPEN
  CLOSED
  REFUNDED
}

model Charge {
  id          String         @id @default(cuid())
  propertyId  String
  property    Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  folioId     String
  folio       Folio          @relation(fields: [folioId], references: [id], onDelete: Cascade)
  idempotencyKey String?
  intentFingerprint String?
  sourceEmailEventId String?
  sourceEmailEvent BookingEmailEvent? @relation("ChargeSourceEmail", fields: [sourceEmailEventId], references: [id], onDelete: SetNull)
  date        DateTime       @db.Date
  description String
  category    ChargeCategory
  amount      Float
  amountSatang BigInt?
  quantity    Int            @default(1)
  total       Float
  totalSatang BigInt?
  void        Boolean        @default(false)
  voidReason  String?
  createdBy   String
  createdAt   DateTime       @default(now())
  
  @@index([folioId])
  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, createdAt])
  @@index([sourceEmailEventId])
  @@index([date])
}

enum ChargeCategory {
  ROOM
  EXTRA_GUEST
  CHILD
  CAFE
  MINIBAR
  LAUNDRY
  DAMAGE
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  propertyId  String
  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  folioId     String
  folio       Folio         @relation(fields: [folioId], references: [id], onDelete: Cascade)
  amount      Float
  amountSatang BigInt?
  method      PaymentMethod
  idempotencyKey String?
  reference   String?
  referenceFingerprint String?
  sourceEmailEventId String?   @unique
  sourceEmailEvent BookingEmailEvent? @relation("PaymentSourceEmail", fields: [sourceEmailEventId], references: [id], onDelete: SetNull)
  notes       String?
  processedBy String
  createdAt   DateTime      @default(now())
  
  @@index([folioId])
  @@unique([propertyId, idempotencyKey])
  @@unique([propertyId, referenceFingerprint])
  @@index([propertyId, createdAt])
  @@index([reference])
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

model GuestDocument {
  id          String   @id @default(cuid())
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  sourceEmailEventId String?
  sourceEmailEvent BookingEmailEvent? @relation("GuestDocumentSourceEmail", fields: [sourceEmailEventId], references: [id], onDelete: SetNull)
  type        String
  fileName    String
  fileUrl     String
  uploadedBy  String
  notes       String?
  createdAt   DateTime @default(now())
  
  @@index([guestId])
  @@index([reservationId])
  @@index([sourceEmailEventId])
}

model BookingEmailSource {
  id          String               @id @default(cuid())
  propertyId  String
  property    Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  provider    BookingEmailProvider @default(GMAIL)
  mailbox     String
  enabled     Boolean              @default(true)
  autoProcessSafeEvents Boolean    @default(false)
  reviewThreshold Float            @default(0.85)
  query       String?
  credentialsRef String?
  lastSyncAt  DateTime?
  lastSyncCursor String?
  lastError   String?
  events      BookingEmailEvent[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([propertyId, mailbox])
  @@index([propertyId, enabled])
  @@index([provider])
}

enum BookingEmailProvider {
  GMAIL
  IMAP
  FORWARDED_MAILBOX
  MANUAL
  OTHER
}

model BookingEmailEvent {
  id          String                  @id @default(cuid())
  propertyId  String
  property    Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sourceId    String?
  source      BookingEmailSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceName  String?
  sourceMailbox String?
  sourceMessageId String?
  threadId    String?
  rawEmailUrl String?
  sender      String
  recipient   String?
  subject     String?
  receivedAt  DateTime
  eventType   BookingEmailEventType   @default(UNKNOWN)
  status      BookingEmailEventStatus @default(NEEDS_REVIEW)
  confidence  Float                   @default(0)
  channelRef  String?
  guestName   String?
  checkIn     DateTime?               @db.Date
  checkOut    DateTime?               @db.Date
  roomType    String?
  amount      Float?
  amountSatang BigInt?
  currency    String?
  paymentStatus String?
  proposedAction String?
  completedAction String?
  reviewReason String?
  errorReason String?
  parsedDetails Json?
  rawHeaders  Json?
  rawText     String?
  reservationId String?
  reservation Reservation?            @relation("BookingEmailEventReservation", fields: [reservationId], references: [id], onDelete: SetNull)
  sourceReservation Reservation?      @relation("ReservationSourceEmail")
  sourcePayment Payment?              @relation("PaymentSourceEmail")
  sourceCharges Charge[]              @relation("ChargeSourceEmail")
  sourceDocuments GuestDocument[]     @relation("GuestDocumentSourceEmail")
  duplicateOfEventId String?
  duplicateOfEvent BookingEmailEvent? @relation("DuplicateBookingEmailEvent", fields: [duplicateOfEventId], references: [id], onDelete: SetNull)
  duplicateEvents BookingEmailEvent[] @relation("DuplicateBookingEmailEvent")
  processedAt DateTime?
  processedBy String?
  rejectedAt  DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([sourceId, sourceMessageId])
  @@index([propertyId, status, receivedAt])
  @@index([sourceId, receivedAt])
  @@index([reservationId])
  @@index([eventType, status])
  @@index([channelRef])
}

enum BookingEmailEventStatus {
  NEEDS_REVIEW
  PROCESSED
  ERROR
  IGNORED
}

enum BookingEmailEventType {
  NEW_BOOKING
  MODIFICATION
  CANCELLATION
  PAYMENT_NOTICE
  GUEST_MESSAGE
  UNKNOWN
}

model ReservationLog {
  id            String             @id @default(cuid())
  reservationId String
  reservation   Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  action        ReservationAction
  fromStatus    ReservationStatus?
  toStatus      ReservationStatus?
  changes       Json?
  performedBy   String
  notes         String?
  createdAt     DateTime           @default(now())
  
  @@index([reservationId, createdAt])
}

enum ReservationAction {
  CREATED
  MODIFIED
  ASSIGNED_ROOM
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  RATE_ADJUSTED
  MOVED_ROOM
  DEPOSIT_PAID
}

model RoomStatusLog {
  id         String      @id @default(cuid())
  roomId     String
  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromStatus RoomStatus?
  toStatus   RoomStatus
  changedBy  String
  notes      String?
  createdAt  DateTime    @default(now())
  
  @@index([roomId, createdAt])
}

model User {
  id                  String   @id @default(cuid())
  email               String?  @unique
  username            String   @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                UserRole @default(FRONT_DESK)
  active              Boolean  @default(true)
  failedLoginAttempts Int      @default(0)
  lockedAt            DateTime?
  lastLogin           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  propertyMemberships UserPropertyMembership[]
  assignedHousekeepingTasks HousekeepingTask[] @relation("HousekeepingTaskAssignee")
  assignedHousekeepingIssues HousekeepingIssue[] @relation("HousekeepingIssueAssignee")
  
  @@index([email])
  @@index([username])
  @@index([lockedAt])
  @@index([role, active])
}

// Accounting V2 is additive while the operational Folio relation remains the
// compatibility source for existing routes. New accounting writes are gated by
// ACCOUNTING_V2_ENABLED and use satang-only, append-only ledger records.
model AccountingFolio {
  id                 String                    @id @default(cuid())
  propertyId         String
  property           Property                  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservationId      String
  reservation        Reservation               @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  folioNumber        String
  type               AccountingFolioType       @default(GUEST)
  currency           String                    @default("THB")
  isPrimary          Boolean                   @default(false)
  status             AccountingFolioStatus     @default(OPEN)
  actorId            String
  reason             String
  auditEvidence      Json?
  idempotencyKey     String
  charges            AccountingCharge[]
  payments           AccountingPayment[]
  receivableEntries  AccountsReceivableEntry[]
  journalLines       JournalLine[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([propertyId, folioNumber])
  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, reservationId, status])
  @@index([reservationId, isPrimary])
}

enum AccountingFolioType {
  GUEST
  MASTER
  COMPANY
  HOUSE
}

enum AccountingFolioStatus {
  OPEN
  CLOSED
}

model AccountingCharge {
  id                 String                    @id @default(cuid())
  propertyId         String
  folioId            String
  folio              AccountingFolio           @relation(fields: [folioId], references: [id], onDelete: Restrict)
  kind               AccountingChargeKind      @default(CHARGE)
  description        String
  amountSatang       BigInt
  originalChargeId   String?
  originalCharge     AccountingCharge?         @relation("AccountingChargeReversal", fields: [originalChargeId], references: [id], onDelete: Restrict)
  reversals          AccountingCharge[]         @relation("AccountingChargeReversal")
  actorId            String
  reason             String
  auditEvidence      Json?
  idempotencyKey     String
  createdAt          DateTime                  @default(now())

  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, folioId, createdAt])
  @@index([originalChargeId])
}

enum AccountingChargeKind {
  CHARGE
  REVERSAL
}

model AccountingPayment {
  id                 String                    @id @default(cuid())
  propertyId         String
  folioId            String
  folio              AccountingFolio           @relation(fields: [folioId], references: [id], onDelete: Restrict)
  kind               AccountingPaymentKind     @default(PAYMENT)
  method             PaymentMethod
  amountSatang       BigInt
  reference          String?
  cashShiftId        String?
  cashShift          CashShift?                 @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  originalPaymentId  String?
  originalPayment    AccountingPayment?        @relation("AccountingPaymentReversal", fields: [originalPaymentId], references: [id], onDelete: Restrict)
  reversals          AccountingPayment[]        @relation("AccountingPaymentReversal")
  actorId            String
  reason             String
  auditEvidence      Json?
  idempotencyKey     String
  createdAt          DateTime                  @default(now())

  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, folioId, createdAt])
  @@index([cashShiftId])
  @@index([originalPaymentId])
}

enum AccountingPaymentKind {
  PAYMENT
  REFUND
  REVERSAL
}

model CashShift {
  id                  String             @id @default(cuid())
  propertyId          String
  property            Property           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  cashierId           String
  status              CashShiftStatus    @default(OPEN)
  currency            String             @default("THB")
  openingFloatSatang  BigInt
  expectedCloseSatang BigInt?
  actualCloseSatang   BigInt?
  varianceSatang      BigInt?
  openedBy            String
  closedBy            String?
  closeReason         String?
  auditEvidence       Json?
  idempotencyKey      String
  closeIdempotencyKey String?
  movements           CashMovement[]
  cashPayments        AccountingPayment[]
  openedAt            DateTime           @default(now())
  closedAt            DateTime?

  @@unique([propertyId, idempotencyKey])
  @@unique([propertyId, closeIdempotencyKey])
  @@index([propertyId, cashierId, status])
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

model CashMovement {
  id             String                @id @default(cuid())
  propertyId     String
  cashShiftId    String
  cashShift      CashShift             @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  type           CashMovementType
  amountSatang   BigInt
  actorId        String
  reason         String
  auditEvidence  Json?
  idempotencyKey String
  createdAt      DateTime              @default(now())

  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, cashShiftId, createdAt])
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

model HouseAccount {
  id                  String                    @id @default(cuid())
  propertyId          String
  property            Property                  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  accountNumber       String
  name                String
  currency            String                    @default("THB")
  status              HouseAccountStatus        @default(ACTIVE)
  createdBy           String
  reason              String
  auditEvidence       Json?
  idempotencyKey      String
  receivableEntries   AccountsReceivableEntry[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([propertyId, accountNumber])
  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, status])
}

enum HouseAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model AccountsReceivableEntry {
  id                    String                       @id @default(cuid())
  propertyId            String
  houseAccountId        String
  houseAccount          HouseAccount                 @relation(fields: [houseAccountId], references: [id], onDelete: Restrict)
  folioId               String?
  folio                 AccountingFolio?             @relation(fields: [folioId], references: [id], onDelete: Restrict)
  kind                  AccountsReceivableEntryKind
  amountSatang          BigInt
  originalEntryId       String?
  originalEntry         AccountsReceivableEntry?     @relation("AccountsReceivableReversal", fields: [originalEntryId], references: [id], onDelete: Restrict)
  reversals             AccountsReceivableEntry[]     @relation("AccountsReceivableReversal")
  actorId               String
  reason                String
  auditEvidence         Json?
  idempotencyKey        String
  createdAt             DateTime                     @default(now())

  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, houseAccountId, createdAt])
  @@index([folioId])
  @@index([originalEntryId])
}

enum AccountsReceivableEntryKind {
  TRANSFER
  SETTLEMENT
  REVERSAL
}

model JournalEntry {
  id             String              @id @default(cuid())
  propertyId     String
