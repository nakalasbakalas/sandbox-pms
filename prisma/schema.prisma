  id                String            @id @default(cuid())
  propertyId        String
  property          Property          @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  policyId          String?
  policy            AutonomyPolicy?   @relation(fields: [policyId], references: [id], onDelete: Restrict)
  externalEventId   String?
  externalEvent     ExternalProviderEvent? @relation(fields: [externalEventId], references: [id], onDelete: Restrict)
  runType           String
  triggerType       String
  mode              AutonomyMode      @default(OBSERVE)
  status            AutonomyRunStatus @default(PENDING)
  correlationId     String
  idempotencyKey    String
  triggeredBy       String
  managementSummary Json?
  errorSummary      String?
  startedAt         DateTime?
  completedAt       DateTime?
  decisions         AgentDecision[]
  actions           ActionExecution[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, status, createdAt])
  @@index([externalEventId])
  @@index([correlationId])
}

model AgentDecision {
  id                    String               @id @default(cuid())
  propertyId            String
  property              Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  runId                 String
  run                   AutonomyRun          @relation(fields: [runId], references: [id], onDelete: Restrict)
  policyId              String?
  policy                AutonomyPolicy?      @relation(fields: [policyId], references: [id], onDelete: Restrict)
  externalEventId       String?
  externalEvent         ExternalProviderEvent? @relation(fields: [externalEventId], references: [id], onDelete: Restrict)
  agentType             String
  decisionType          String
  outcome               AgentDecisionOutcome
  confidenceBasisPoints Int
  rationale             String
  proposedAction        Json?
  policyEvaluation      Json
  correlationId         String
  idempotencyKey        String
  actions               ActionExecution[]
  createdAt             DateTime             @default(now())

  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, outcome, createdAt])
  @@index([runId, createdAt])
  @@index([externalEventId])
  @@index([correlationId])
}

model ActionExecution {
  id                  String                @id @default(cuid())
  propertyId          String
  property            Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  runId               String
  run                 AutonomyRun           @relation(fields: [runId], references: [id], onDelete: Restrict)
  decisionId          String
  decision            AgentDecision         @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  provider            String?
  actionType          String
  targetType          String?
  targetId            String?
  mode                ActionExecutionMode   @default(SHADOW_NOOP)
  status              ActionExecutionStatus @default(RECORDED)
  candidatePayload    Json?
  result              Json?
  providerRequestSent Boolean               @default(false)
  retryCount          Int                   @default(0)
  correlationId       String
  idempotencyKey      String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, status, createdAt])
  @@index([runId, createdAt])
  @@index([decisionId])
  @@index([correlationId])
}

model ReconciliationIssue {
  id                  String                      @id @default(cuid())
  propertyId          String
  property            Property                    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  channelId           String?
  channel             Channel?                    @relation(fields: [channelId], references: [id], onDelete: Restrict)
  externalEventId     String?
  externalEvent       ExternalProviderEvent?      @relation(fields: [externalEventId], references: [id], onDelete: Restrict)
  snapshotId          String?
  snapshot            ProviderSnapshot?           @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  provider            String
  issueType           String
  fingerprint         String
  severity            ReconciliationIssueSeverity
  status              ReconciliationIssueStatus   @default(OPEN)
  pmsAggregateType    String?
  pmsAggregateId      String?
  providerReferenceId String?
  summary             String
  sanitizedEvidence   Json?
  correlationId       String
  detectedAt          DateTime                    @default(now())
  acknowledgedAt      DateTime?
  acknowledgedBy      String?
  resolvedAt          DateTime?
  resolvedBy          String?
  resolutionReason    String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([propertyId, fingerprint])
  @@index([propertyId, status, severity, detectedAt])
  @@index([channelId, status])
  @@index([externalEventId])
  @@index([snapshotId])
  @@index([correlationId])
}

model DeadLetterEvent {
  id                  String           @id @default(cuid())
  propertyId          String
  property            Property         @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  channelId           String?
  channel             Channel?         @relation(fields: [channelId], references: [id], onDelete: Restrict)
  externalEventId     String?           @unique
  externalEvent       ExternalProviderEvent? @relation(fields: [externalEventId], references: [id], onDelete: Restrict)
  provider            String
  providerEventId     String?
  providerReferenceId String?
  eventVersion        String?
  failureStage        String
  errorCode           String
  errorSummary        String
  sanitizedPayload    Json?
  sanitizedEvidence   Json?
  retryCount          Int              @default(0)
  nextRetryAt         DateTime?
  status              DeadLetterStatus @default(OPEN)
  correlationId       String
  idempotencyKey      String
  resolvedAt          DateTime?
  resolvedBy          String?
  resolutionReason    String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, status, nextRetryAt])
  @@index([channelId, status])
  @@index([correlationId])
}
