NODE_ENV=development
PORT=10000
PMS_UI_VARIANT=lite
PMS_WRITE_MODE=active

DATABASE_URL="postgresql://sandbox:sandbox@localhost:55432/sandbox_hotel_dev?schema=public"
E2E_DATABASE_URL="postgresql://sandbox:sandbox@localhost:55432/sandbox_hotel_e2e?schema=public"
ALLOW_DB_E2E=false

VITE_PMS_API_MODE=server
SESSION_SECRET=replace-with-a-long-local-secret

SEED_MODE=dev
SEED_USERS_JSON=
SEED_ADMIN_EMAIL=
ALLOW_PROD_ROOM_ONBOARDING=false

# Set one of these legacy values only if you want to bypass the first-run setup wizard locally.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PASSWORD_HASH=
SEED_USER_PASSWORD_HASH=

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Hotel Ops OTA worker. Leave blank to use the local signed mock worker path.
OTA_DRY_RUN=true
OTA_WORKER_BASE_URL=
OTA_WORKER_SHARED_SECRET=

# In-process Hotel Ops scans are interval-only. Cron expressions are stored as
# an external scheduler contract; cron execution must call POST /api/ops/scan/run.
HOTEL_OPS_SCAN_INTERVAL_MINUTES=
HOTEL_OPS_SCAN_CRON=

# Booking.com adapter credentials are read only by backend adapter code. The
# BOOKING_USERNAME/BOOKING_PASSWORD aliases are also supported for compatibility.
BOOKING_USERNAME=
BOOKING_PASSWORD=
BOOKING_COM_USERNAME=
BOOKING_COM_PASSWORD=
BOOKING_FORCE_HUMAN_CHALLENGE=
OTA_ENABLE_REAL_BROWSER_WRITES=false

# Channel-sync v2 policy. The manual availability queue never dispatches automatically.
CHANNEL_MANAGER_PROVIDER=channex

# Booking email intake. Do not store the Gmail account password here.
BOOKING_EMAIL_PRIMARY_MAILBOX=booking@sandboxhotel.com
BOOKING_EMAIL_GMAIL_USER_ID=me
BOOKING_EMAIL_GMAIL_ACCESS_TOKEN=
BOOKING_EMAIL_GMAIL_CLIENT_ID=
BOOKING_EMAIL_GMAIL_CLIENT_SECRET=
BOOKING_EMAIL_GMAIL_REFRESH_TOKEN=
BOOKING_EMAIL_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
# Optional local near-live polling. Review-only; no automatic reservation mutations.
BOOKING_EMAIL_NEAR_LIVE_ENABLED=false
BOOKING_EMAIL_SYNC_INTERVAL_SECONDS=120
BOOKING_EMAIL_SYNC_BATCH_LIMIT=25

# Optional authenticated Gmail Pub/Sub delivery for local Lite testing.
BOOKING_EMAIL_GMAIL_PUBSUB_ENABLED=false
BOOKING_EMAIL_GMAIL_PUBSUB_TOPIC=
BOOKING_EMAIL_GMAIL_PUBSUB_SUBSCRIPTION=
BOOKING_EMAIL_GMAIL_PUBSUB_AUDIENCE=
BOOKING_EMAIL_GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
